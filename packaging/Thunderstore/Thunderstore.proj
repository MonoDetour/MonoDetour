<Project Sdk="Microsoft.Build.NoTargets/3.7.56">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <VersionPrefix>$(MonoDetourVersionPrefix)</VersionPrefix>
    <VersionSuffix>$(MonoDetourVersionSuffix)</VersionSuffix>
    <!--
      For the Thunderstore version number, we append a two-digit sub version for
      updating the package because Thunderstore requires a new version to be uploaded
      to add a package to new communities.
    -->
    <Major>$(VersionPrefix.Split('.')[0])</Major>
    <Minor>$(VersionPrefix.Split('.')[1])</Minor>
    <Patch>$(VersionPrefix.Split('.')[2])</Patch>
    <TsPatch>$([MSBuild]::Add($([MSBuild]::Multiply($(Patch), 100)), $(ThunderstoreSubVersion)))</TsPatch>
    <ThunderstoreVersion>$(Major).$(Minor).$(TsPatch)</ThunderstoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MonoDetour.BepInEx.5/MonoDetour.BepInEx.5.csproj" />
    <ProjectReference Include="../MonoDetour.BepInEx.6/MonoDetour.BepInEx.6.csproj" />
  </ItemGroup>

  <Target Name="ProcessTcliConfigs" AfterTargets="Build">
    <PropertyGroup>
      <ProcessCommand><![CDATA[sed -e 's/__MonoDetour_Version__/$(ThunderstoreVersion)/' -e 's/__config__/$(ConfigurationLower)/' ./thunderstore.toml > ./.processed.toml]]></ProcessCommand>
    </PropertyGroup>
    <Exec Command="$(ProcessCommand)" WorkingDirectory="." />
    <Exec Command="$(ProcessCommand)" WorkingDirectory="../MonoDetour.BepInEx.5/" />
    <Exec Command="$(ProcessCommand)" WorkingDirectory="../MonoDetour.BepInEx.5.Resonite/" />
    <Exec Command="$(ProcessCommand)" WorkingDirectory="../MonoDetour.BepInEx.6/" />
  </Target>

  <Target Name="PackThunderstore" AfterTargets="ProcessTcliConfigs">
    <Exec Command="dotnet tcli build --config-path &quot;$(ProjectDir).processed.toml&quot;" />
    <Exec Command="dotnet tcli build --config-path &quot;$(ProjectDir)../MonoDetour.BepInEx.5/.processed.toml&quot;" />
    <Exec Command="dotnet tcli build --config-path &quot;$(ProjectDir)../MonoDetour.BepInEx.5.Resonite/.processed.toml&quot;" />
    <Exec Command="dotnet tcli build --config-path &quot;$(ProjectDir)../MonoDetour.BepInEx.6/.processed.toml&quot;" />
  </Target>

  <!--
    We build and publish the TS packages separately because we want all packages to build before
    any are published to make sure that either everything successfully publishes or nothing does.
  -->
  <!-- Call with `dotnet build ./packaging/ -c Release -property:PublishMonoDetour=true` -->
  <Target Name="PublishThunderstore" AfterTargets="PackThunderstore" Condition="'$(PublishMonoDetour)' == 'true'" >
    <Exec Command="dotnet tcli publish --config-path &quot;$(ProjectDir).processed.toml&quot; --file &quot;$(SolutionRoot)artifacts/thunderstore/MonoDetour-MonoDetour-$(ThunderstoreVersion).zip&quot;" />
    <Exec Command="dotnet tcli publish --config-path &quot;$(ProjectDir)../MonoDetour.BepInEx.5/.processed.toml&quot; --file &quot;$(SolutionRoot)artifacts/thunderstore/MonoDetour-MonoDetour_BepInEx_5-$(ThunderstoreVersion).zip&quot;" />
    <Exec Command="dotnet tcli publish --config-path &quot;$(ProjectDir)../MonoDetour.BepInEx.5.Resonite/.processed.toml&quot; --file &quot;$(SolutionRoot)artifacts/thunderstore/MonoDetour-MonoDetour_BepInEx_5_Resonite-$(ThunderstoreVersion).zip&quot;" />
    <Exec Command="dotnet tcli publish --config-path &quot;$(ProjectDir)../MonoDetour.BepInEx.6/.processed.toml&quot; --file &quot;$(SolutionRoot)artifacts/thunderstore/MonoDetour-MonoDetour_BepInEx_6-$(ThunderstoreVersion).zip&quot;" />
  </Target>
</Project>
